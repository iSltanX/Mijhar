# نظام التشغيل
.DS_Store

# اعتماديات ومخرجات البناء (تظهر من المرحلة 1)
node_modules/
dist/
coverage/
*.log

# ملفات محلية
.env
.env.*

# مولَّد بـ node tools/build.mjs --sync من أي مجلد؛ غير متتبَّع حتى تعرض الصفحة تقدم الفروع
dashboard/data.js

# worktrees الجلسات إن أُنشئت داخل المجلد
.claude/worktrees/

# كاش الأدوات والملفات المؤقتة
.cache/
.vite/
.vitest/
.eslintcache
*.tsbuildinfo
tmp/
temp/
*.tmp
*.swp

# مخرجات الاختبارات واللقطات المحلية (قد تحمل معلومات شخصية)
test-results/
playwright-report/
screenshots/
*.screenshot.png
# لقطات الإصدار الحقيقية تُتتبَّع (release/README.md)، والحزم المبنية مولَّدة لا تُتتبَّع
!release/screenshots/
release/packages/

# ملفات أسرار ومفاتيح وبيانات دخول وإعدادات محلية
*.pem
*.key
*.p12
*.pfx
.npmrc
.netrc
.claude/settings.local.json
CLAUDE.local.md

# ملفات تعريف المتصفحات المؤقتة لفحوص التحميل
*-profile/
mijhar-load-check-*/
