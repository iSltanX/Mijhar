{
  "manifest_version": 3,
  "name": "مِجهَر",
  "description": "يصحّح اتجاه العربية في GitHub، ويشرح الواجهة في مكانها، ويلخّص حالة طلب الدمج وسبب فشل الفحص. يعمل بلا حساب ولا مفتاح.",
  "homepage_url": "https://bysltan.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://app-reports.isultantf.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "مِجهَر",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "افتح لوحة مِجهَر أو الدرج"
    },
    "open-glossary": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "ابحث في قاموس مِجهَر"
    }
  }
}
