{
  "manifest_version": 3,
  "name": "مِجهَر",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": ["https://api.github.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://github.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+G" },
      "description": "افتح لوحة مِجهَر أو الدرج"
    },
    "open-glossary": {
      "suggested_key": { "default": "Alt+K" },
      "description": "ابحث في قاموس مِجهَر"
    }
  }
}
