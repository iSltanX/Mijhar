{
  "manifest_version": 3,
  "name": "مِجهَر",
  "browser_specific_settings": {
    "gecko": {
      "id": "mijhar@mijhar.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": ["https://api.github.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "مِجهَر",
    "open_at_install": false
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://github.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+G" },
      "description": "افتح لوحة مِجهَر أو الدرج"
    },
    "open-glossary": {
      "suggested_key": { "default": "Alt+K" },
      "description": "ابحث في قاموس مِجهَر"
    }
  }
}
